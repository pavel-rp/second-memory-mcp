{
  "name": "second-memory-learning",
  "version": "0.1.221",
  "description": "MCP server for AI-powered spaced repetition learning with Postgres",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Pavel Kalabin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavel-rp/second-memory-mcp.git"
  },
  "keywords": [
    "mcp",
    "spaced-repetition",
    "learning",
    "claude",
    "postgres"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:clean": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json -w",
    "start": "node dist/transport/main.js",
    "start:pnpm": "pnpm run build && node dist/transport/main.js",
    "start:stdio": "node dist/transport/main.js",
    "start:http": "cross-env TRANSPORT=http node dist/transport/main.js",
    "start:stdio:debug": "node --inspect=0 dist/transport/main.js",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "pnpm run build && vitest run --config vitest.integration.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:embedding": "pnpm run build && vitest run --config vitest.embedding.config.ts",
    "test:ci": "pnpm run build && vitest run --coverage",
    "test": "pnpm run test:ci && pnpm run test:embedding",
    "lint": "eslint src tests --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"tests/**/*.{ts,tsx,js,jsx}\"",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "db:seed": "tsx src/infrastructure/db/seed.ts",
    "lint:validate": "tsx scripts/lint-validate.ts",
    "lint:corpus:seed": "tsx scripts/lint-corpus-seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.prod -- drizzle-kit studio",
    "db:studio:test": "dotenv -e .env -- drizzle-kit studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "tests/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.29",
    "@langchain/ollama": "^1.2.5",
    "@langchain/openai": "^1.2.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "compromise": "^14.15.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "jose": "^6.2.1",
    "markdown-it": "^14.1.1",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.35",
    "@types/pg": "^8.11.13",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
