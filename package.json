{
  "name": "second-memory-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node dist/server/main.js",
    "start:pnpm": "pnpm run build && node dist/server/main.js",
    "start:stdio": "node dist/server/main.js",
    "test:prompts": "node scripts/test-prompts.mjs",
    "test": "pnpm run build && vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.14",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "^4.16.0"
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "exclude": [
        "scripts/**"
      ]
    }
  }
}
