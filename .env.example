# =============================================================================
# Second Memory Learning — Environment Variables
# =============================================================================
# Copy this file to .env and uncomment/edit the values you want to override.
# Only DATABASE_URL is required; everything else has sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/second_memory

# Enable verbose debug logging to stderr
# DEBUG=true

# -----------------------------------------------------------------------------
# Transport
# -----------------------------------------------------------------------------

# Transport mode: "stdio" (default, for local AI clients) or "http" (Streamable HTTP/SSE)
# TRANSPORT=stdio

# HTTP server port (only used when TRANSPORT=http)
# HTTP_PORT=3000

# HTTP server bind address (only used when TRANSPORT=http)
# HTTP_HOST=127.0.0.1

# Comma-separated hostnames allowed by the SDK Host-header DNS-rebinding check
# (only used when TRANSPORT=http). REQUIRED when HTTP_HOST is a non-localhost
# bind (e.g. 0.0.0.0) — the server refuses to start without it (fail-fast).
# Localhost binds (127.0.0.1/localhost/::1) keep the SDK's automatic localhost
# validation and need no ALLOWED_HOSTS. List the hostnames clients use to reach
# the server (no ports; for IPv6 use brackets, e.g. [::1]).
# ALLOWED_HOSTS=mcp.example.com

# -----------------------------------------------------------------------------
# HTTP Auth (only used when TRANSPORT=http; STDIO is unauthenticated)
# -----------------------------------------------------------------------------
# When TRANSPORT=http, AUTH_ISSUER, AUTH_AUDIENCE, and CORS_ALLOWED_ORIGINS are
# all REQUIRED — the server refuses to start without them (fail-fast). STDIO
# ignores them all.

# OIDC issuer base URL. OIDC discovery + JWKS are fetched from here to verify
# JWT signatures. Must be a valid absolute URL.
# AUTH_ISSUER=https://auth.example.com

# Expected JWT `aud` claim. REQUIRED in HTTP mode (NEU-833): every bearer token
# is validated against it, so a token minted for a different audience is
# rejected with 401. Must be a valid absolute URL — it also doubles as the PRM
# `resource` identifier and the WWW-Authenticate `resource_metadata` base URL.
# Set it to the resource URL (if your IdP supports RFC 8707 resource
# indicators) or to the URL-shaped client_id your IdP emits as `aud`.
# AUTH_AUDIENCE=https://mcp.example.com/mcp

# Comma-separated CORS allowlist of explicit browser Origin values
# (scheme+host+port). REQUIRED in HTTP mode (NEU-834): this single list governs
# both CORS reflection and the transport-level 403 rejection of forged Origins,
# so an unset value or a wildcard "*" fails startup (a wildcard would make the
# 403 rejection inert). Requests without an Origin header (non-browser MCP
# clients) are never rejected.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# -----------------------------------------------------------------------------
# HTTP Rate Limiting (only used when TRANSPORT=http; STDIO is unaffected)
# -----------------------------------------------------------------------------
# In-app per-authenticated-subject rate limiter for POST /mcp (NEU-835 / OUT-9).
# Keyed on the JWT subject (sub/azp) the auth layer resolves — not the MCP
# session. A subject exceeding its limit gets HTTP 429 (with Retry-After); other
# subjects are unaffected. Enabled by default in HTTP mode. State is per-instance
# and in-memory: the deployment assumption is a single instance — running
# multiple replicas multiplies the effective limit by the replica count.

# Max POST /mcp requests per window, per subject (default: 120). Set to 0 (or any
# non-positive value) to disable the limiter entirely.
# RATE_LIMIT_MAX=120

# Rolling window length in milliseconds (default: 60000 = 1 minute).
# RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# SM-2 Algorithm — Base Parameters
# -----------------------------------------------------------------------------

# Minimum ease factor floor (>= 1.3)
# SM_MIN_EASE_FACTOR=1.3

# Interval in days for the very first successful review
# SM_INITIAL_INTERVAL_DAYS=1

# Interval in days for the second successful review
# SM_SECOND_INTERVAL_DAYS=6

# Additive ease factor delta when quality >= 4 (good)
# SM_EASE_DELTA_GOOD=0.1

# Additive ease factor delta when quality === 3 (hard)
# SM_EASE_DELTA_HARD=-0.02

# Additive ease factor delta when quality < 3 (failure)
# SM_EASE_PENALTY_FAILURE=-0.2

# Ease factor threshold for weak-area detection (clamped to SM_MIN_EASE_FACTOR if below)
# SM_WEAK_AREA_EASE_THRESHOLD=2.5

# -----------------------------------------------------------------------------
# SM-2 Algorithm — Priority Weights
# -----------------------------------------------------------------------------

# Weight for time-until-next-review urgency (0-1)
# SM_PRIORITY_W_URGENCY=0.6

# Weight for inverse ease (0-1)
# SM_PRIORITY_W_EASE=0.15

# Weight for lower repetitions (0-1)
# SM_PRIORITY_W_REPS=0.1

# Weight for difficulty (0-1)
# SM_PRIORITY_W_DIFF=0.15

# -----------------------------------------------------------------------------
# SM-2 Algorithm — Lapse & Leech Handling
# -----------------------------------------------------------------------------

# Additional ease factor penalty when overdue
# SM_LAPSE_PENALTY=-0.15

# Consecutive lapses before harsher reset
# SM_MAX_CONSEC_LAPSES=3

# Failures across window to flag as leech
# SM_LEECH_FAIL_THRESHOLD=6

# Consecutive failures to flag as leech
# SM_LEECH_CONSEC_FAILS=3

# Extra negative ease factor delta for leeches
# SM_LEECH_EASE_ADJUST=-0.05

# Lower bound for leech ease penalty
# SM_MIN_LEECH_EASE_PENALTY=-0.25

# -----------------------------------------------------------------------------
# Daily Caps
# -----------------------------------------------------------------------------

# Maximum new items per day
# SM_DAILY_CAP_NEW=20

# Maximum reviews per day
# SM_DAILY_CAP_REVIEWS=200

# -----------------------------------------------------------------------------
# Tag Weights
# -----------------------------------------------------------------------------

# JSON object mapping tag names to priority weights, e.g. {"math":1.5,"history":0.8}
# SM_TAG_WEIGHTS={}

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------

# Quality score threshold for session completion (0-5)
# SM_SESSION_QUALITY_THRESHOLD=4.0

# Time threshold in ms for time-based completion (default: 90 min)
# SM_SESSION_TIME_THRESHOLD_MS=5400000

# Progress threshold for session completion (0-1, default: 80%)
# SM_SESSION_COMPLETION_THRESHOLD=0.8

# Maximum session duration in ms (default: 2 hours)
# SM_SESSION_MAX_TIME_MS=7200000

# -----------------------------------------------------------------------------
# Recommendation — Cognitive Load
# -----------------------------------------------------------------------------

# Default maximum cognitive load per session
# SM_REC_MAX_COG_LOAD_DEFAULT=20

# Threshold below which items are considered easy
# SM_REC_COG_EASY_THRESHOLD=8

# Threshold above which items are considered hard
# SM_REC_COG_HARD_THRESHOLD=15

# Heuristic factor to scale cognitive load with time
# SM_REC_COG_PER_MIN_FACTOR=0.5

# -----------------------------------------------------------------------------
# Recommendation — Session Composition
# -----------------------------------------------------------------------------

# Default max new items per session
# SM_REC_MAX_NEW_DEFAULT=3

# Minutes threshold for short sessions
# SM_REC_SHORT_SESSION_MIN=15

# Max new items for short sessions
# SM_REC_MAX_NEW_SHORT=1

# Minutes threshold for long sessions
# SM_REC_LONG_SESSION_MIN=45

# Max new items for long sessions
# SM_REC_MAX_NEW_LONG=5

# Interleave strategy: "easy-medium-hard" or "balanced"
# SM_REC_INTERLEAVE_STRATEGY=easy-medium-hard

# -----------------------------------------------------------------------------
# Recommendation — Conversation
# -----------------------------------------------------------------------------

# Enable encouragement messages (true/false)
# SM_REC_CONVO_ENCOURAGEMENT=true

# Enable progress update messages (true/false)
# SM_REC_CONVO_PROGRESS=true

# Guidance verbosity: "low", "medium", or "high"
# SM_REC_CONVO_VERBOSITY=medium

# -----------------------------------------------------------------------------
# Prerequisite — Validation
# -----------------------------------------------------------------------------

# Fail on any invalid prerequisite references (true/false)
# SM_PREREQ_STRICT_VALIDATION=false

# Max depth for dependency graph traversal
# SM_PREREQ_MAX_DEPTH=5

# Cache mastery status results (true/false)
# SM_PREREQ_ENABLE_CACHE=true

# Cache expiry time in ms (default: 5 min)
# SM_PREREQ_CACHE_EXPIRY_MS=300000

# -----------------------------------------------------------------------------
# Embedding — Provider & Model
# -----------------------------------------------------------------------------

# Embedding provider: "openai", "ollama", or leave unset to disable semantic search
# EMBEDDING_PROVIDER=

# Vector dimensions (must match DB schema column; default: 1536)
# EMBEDDING_DIMENSIONS=1536

# Model name (default: text-embedding-3-small for OpenAI, nomic-embed-text for Ollama)
# EMBEDDING_MODEL=text-embedding-3-small

# OpenAI API key (required when EMBEDDING_PROVIDER=openai)
# OPENAI_API_KEY=

# Ollama base URL (required when EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Embedding — Resilience & Performance
# -----------------------------------------------------------------------------

# Max retries for embedding API calls (default: 3)
# EMBEDDING_MAX_RETRIES=3

# Max concurrent embedding API calls (default: 10)
# EMBEDDING_MAX_CONCURRENCY=10

# Timeout in ms for embedding API calls (default: 30000; OpenAI only)
# EMBEDDING_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Embedding — Similarity & Hybrid Search
# -----------------------------------------------------------------------------

# Minimum cosine similarity for vector search results (0-1)
# EMBEDDING_SIMILARITY_THRESHOLD=0.3

# Weight for keyword scores in hybrid search (0-1)
# EMBEDDING_HYBRID_KEYWORD_WEIGHT=0.4

# Weight for semantic scores in hybrid search (0-1)
# EMBEDDING_HYBRID_SEMANTIC_WEIGHT=0.6

# -----------------------------------------------------------------------------
# Classifier — Provider & Resilience (NEU-619)
# -----------------------------------------------------------------------------
# Tier 2 LLM-as-judge chunk classifier. Opt-in: the adapter is only constructed
# when CLASSIFIER_PROVIDER is set — otherwise `AppPorts.classifier` stays
# undefined and workflows skip classification. No workflow invokes it in
# NEU-619 — NEU-620 wires it into create_chunk.

# Classifier provider: "openai" or leave unset to disable Tier 2 classification
# CLASSIFIER_PROVIDER=

# Model name (default: gpt-5.4-mini)
# CLASSIFIER_MODEL=gpt-5.4-mini

# OpenAI reasoning effort: "none", "low", "medium", "high", or "xhigh" (default: low).
# Values are what the OpenAI responses API actually accepts for gpt-5.4-mini; "minimal"
# is rejected with a 400 on this model. The adapter always sends this field to the API,
# so if you override CLASSIFIER_MODEL to a non-reasoning model (e.g. gpt-4o), the request
# will be rejected — pair such overrides with an API-compatible value for that model.
# CLASSIFIER_REASONING_EFFORT=low

# Sampling temperature. Leave the variable entirely unset to use the model's default —
# required for reasoning models like gpt-5.4-mini which reject any non-default value.
# Note: CLASSIFIER_TEMPERATURE=0 is NOT equivalent to unset — it passes 0 through to the
# API and will be rejected by reasoning models the same way any other numeric override is.
# CLASSIFIER_TEMPERATURE=

# Base seed for classifier model calls (NEU-757; default: 42, truncated to an integer).
# Best-effort reproducibility: it pins the OpenAI Completions sampler, which applies only
# when CLASSIFIER_MODEL is overridden to a NON-reasoning model. The default reasoning
# model (gpt-5.4-mini) routes to the OpenAI Responses API, which has no seed parameter and
# ignores it — for that path, raise CLASSIFIER_SAMPLES (below) to get determinism, not the
# seed. Always applied: at CLASSIFIER_SAMPLES=1 the single call carries this seed; with
# CLASSIFIER_SAMPLES > 1, sample i uses seed + i (fixed set, distinct per sample).
# CLASSIFIER_SEED=42

# Self-consistency sample count per verdict field (NEU-757; default: 1, clamped to >= 1).
# 1 = a single call (same cost and 6-call fan-out as before). Raise to 3 or 5 to sample
# the model that many times and take the median score / majority applicable, stabilizing
# verdicts near the blocking threshold. This is the effective determinism lever for the
# default reasoning model (whose Responses API ignores seed). WARNING: it multiplies
# per-chunk classifier API calls by this factor. To disable the classifier entirely use
# CLASSIFIER_ENABLE.
# CLASSIFIER_SAMPLES=1

# Max retries per classifier field call (default: 2)
# CLASSIFIER_MAX_RETRIES=2

# Timeout in ms per classifier field call (default: 10000)
# CLASSIFIER_TIMEOUT_MS=10000

# OpenAI API key for the classifier. Falls back to OPENAI_API_KEY when unset.
# CLASSIFIER_OPENAI_API_KEY=

# Global "is the Tier 2 classifier wired" toggle (default: false — opt-in
# because each classify call adds ~2 s p95 external API latency). When true
# AND CLASSIFIER_PROVIDER is configured, the classifier runs on every
# audit-eligible write path: topic creation today (NEU-620) and content-update
# paths once NEU-680 lands.
# CLASSIFIER_ENABLE=true
#
# Backward-compat alias: CLASSIFIER_ENABLE_AT_CREATE is accepted for one
# release. It logs a deprecation warning at startup whenever it is present
# (alone, or alongside CLASSIFIER_ENABLE in agreement); setting it together
# with CLASSIFIER_ENABLE to a different boolean fails fast at startup.

# Per-field blocking allowlist for Tier 2 classifier (NEU-621). Comma-separated
# verdict-field names in snake_case. When a chunk's verdict scores at or below
# the soft-warn threshold on any listed field, topic creation is rejected and
# the just-persisted topic is rolled back. Empty/unset = soft-warn only (the
# NEU-620 default). Operators flip fields one at a time after both calibration
# agreement (>= 0.85) and OOD precision (>= 0.85) have passed; see
# `docs/runbooks/classifier-blocking-activation.md`. Allowed names:
# rendering_clarity, vocabulary_appropriate, math_notation_rendering_risk,
# definition_constructive, epistemic_consistency, overall_fit. Unknown names
# cause startup failure.
# CLASSIFIER_BLOCKING_FIELDS=rendering_clarity

# -----------------------------------------------------------------------------
# Data Import
# -----------------------------------------------------------------------------

# Path to JSON import file for db:seed
# SEED_SOURCE=./seed.json
